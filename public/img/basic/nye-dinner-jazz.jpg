<style type='text/css'></style>		<style type="text/css" id="wp-custom-css">
			@media screen and (max-width:768px){
	.rezbutton {
		display: none !important;
	}
}

.mhs-tablet-land #mobile-top-text, .mhs-tablet-land #mobile-header, .mhs-tablet-land #mobile-header-sticky-wrapper{

    display: block;

}

.mhs-tablet-land .header-wrap, .mhs-tablet-land #top-bar, .mhs-tablet-land #top-bar-sticky-wrapper {

    display: none !important;
    
}

#dmn-partner-widget {
		margin: 0 auto;
}

/* CSS logo */

#mobile-header {
  padding: 25px;
}

#mobile-top-text {
  top: 43px;
  right: 75px;
}

.mobile-header-opts.opts-left {
  left: 26px;
}

#mobile-logo, #mobile-logo.has-img img {
    max-height: none;
    height: 79px;
}

@media screen and (max-width: 768px) {
  #mobile-header {
    padding-top: 25px;
    padding-bottom: 25px;
  }

  .hamburger-box, 
  #mobile-top-text {
    border: 2px solid #E3E1DB;
  }

  #mobile-logo, 
  #mobile-logo.has-img img {
    height: 48px;
  }

  #mobile-top-text {
    top: 39px;
    right: 18px;
    padding: 2px 8px;
    height: 36px;
  }
  
  .mobile-header-opts.opts-left {
    left: 20px;
  }

  .mobile-header-opts {
    margin-top: -14px;
  }

  .hamburger-box {
    height: 31px;
    width: 42px;
    padding: 3px 6px;
  }
	
	.swift-slider-outer, 
	.swift-slider, 
	.swiper-wrapper, 
	.swiper-slide {
  max-height: 448px;
  padding-top: 14px;
	}
}

	.swift-slider-outer, .swift-slider, .swiper-wrapper, .swiper-slide{
		min-height: 85vh !important;
	}


.mhs-tablet-land #mobile-top-text,
.mhs-tablet-land #mobile-header, .mhs-tablet-land #mobile-header-sticky-wrapper {
  display: block ;
  position: fixed;
}

@media (min-width: 480px) {
.single-post .page-heading {
		padding-bottom: 64px;
	}
}

@media (min-width: 768px) {
	.single-post .page-heading {
		padding-bottom: 128px;
	}
}

@media screen and (max-width:768px){
	.language-switcher {
		top: 30px !important;
		
	}
	
.language-switcher img {
		width: 28px !important;
		height: 28px !important;
	}
}
/* Dil değiştirici ana container */
.language-switcher {
    position: fixed;
    top: 47px;
    right: 20px;
    z-index: 99999;
    display: flex;
    gap: 8px;
    align-items: center;
}

.language-switcher img {
    width: 36px;
    height: 36px;
    border-radius: 50%; /* Tam yuvarlak */
    cursor: pointer;
    transition: all 0.3s ease;
    background: white; /* SVG arka planı için */
    padding: 2px; /* SVG etrafında boşluk */
	    object-fit: cover;
}


/* Hover efekti */
.language-switcher img:hover {
    transform: scale(1.1);
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

/* Responsive tasarım için */
@media (max-width: 768px) {
    .language-switcher {
        right: 20px;
    }
    
    .language-switcher img {
        width: 40px;
        height: 28px;
    }
}

.pum-overlay.pum-active,
	.pum-overlay.pum-active .popmake.active {
    		display: block !important;
	}

/* === GNH NEW HERO (NO SLIDER) – SAFE ADDITION === */
/* New lightweight hero (no slider) */
.gnh-hero{
  text-align: center;
  color:#fff;

  /* HERO HEIGHT */
  min-height: 70vh;

  /* VERTICAL + HORIZONTAL CENTERING */
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  padding: 120px 16px 90px;
  position: relative;
  z-index: 1;
}


/* Kicker with side lines */
.gnh-hero-kicker{
  display:inline-block;
  position:relative;
  font-size:16px;
  letter-spacing:2px;
  font-weight:600;
  line-height:1.1;
  text-transform:uppercase;
  margin:0 0 18px 0;
  padding:0 14px;
}

.gnh-hero-kicker:before,
.gnh-hero-kicker:after{
  content:"";
  position:absolute;
  top:50%;
  width:44px;
  border-top:1px solid rgba(255,255,255,0.9);
}

.gnh-hero-kicker:before{ right:100%; margin-right:12px; }
.gnh-hero-kicker:after{ left:100%; margin-left:12px; }

/* Headings */
.gnh-hero-h1{
  font-size:26px;
	line-height:1.1;
  font-weight:500;
  margin:0 0 12px;
  line-height:1.1;
}

.gnh-hero-h2{
  margin:14px 0 16px;
  color:#fff;
  line-height:1.1;
  font-weight:400;
	font-size:62px; 
}

/* Middle underline */
.gnh-hero-h2:after{
  content:"";
  display:block;
  width:44px;
  border-top:1px solid rgba(255,255,255,0.9);
  margin:18px auto 0;
}

/* Sub line */
.gnh-hero-sub{
  font-size:16px;
  letter-spacing:2px;
  text-transform:uppercase;
  margin:0;
  font-weight:600;
}

/* Mobile */
@media (max-width:768px){

  .gnh-hero{
    padding:72px 14px 56px; /* reduce overall hero height */
  }

  .gnh-hero-kicker{
    font-size:11px;
    margin-bottom:6px; /* tighter */
  }

  .gnh-hero-h1{
    font-size:17px;
    margin-bottom:6px;
    line-height:1.2;
  }

  .gnh-hero-h2{
    font-size:30px;      /* slightly smaller */
    line-height:1.1;     /* tighter lines */
    margin:6px 0 8px;    /* reduce vertical gaps */
  }

  .gnh-hero-sub{
    font-size:11px;
    margin-top:6px;
    letter-spacing:1.5px;
  }

}

@media screen and (max-width: 768px) {
  .language-switcher {
    top: 12px !important;
    right: 18px !important;
    z-index: 99999 !important;
  }

  .language-switcher img {
    width: 19px !important;
    height: auto !important;
    padding: 0 !important;
    border-radius: 0 !important;
    background: none !important;
    object-fit: contain !important;
  }
}
		</style>
